{% extends 'base.html.twig' %}

{% block title %}Mon panier - Green Goodies{% endblock %}

{% block body %}
    {# 🎯 On réutilise ta structure globale au fond beige #}
    <div class="account-page">

        <h1 class="account-title">Mon panier</h1>

        {# Conteneur spécifique pour aligner le lien "Vider" et la carte #}
        <div class="cart-container">

            {# 🎯 On n'affiche le lien Vider que s'il y a des articles #}
            {% if items|length > 0 %}
                <form action="{{ path('app_cart_empty') }}" method="POST" style="margin: 0;">
                    <button type="submit" class="btn-empty-cart">x Vider le panier</button>
                </form>
            {% endif %}

            <div class="account-card cart-card">

                {% if items|length > 0 %}
                    {# 🎯 Boucle sur les produits du panier #}
                    {% for item in items %}
                        <div class="cart-item">
                            <img src="{{ asset('uploads/products/' ~ item.product.picture) }}" alt="{{ item.product.name }}" class="cart-item-img">

                            <div class="cart-item-details">
                                <h3>{{ item.product.name }}</h3>
                                <p class="cart-item-qty">Quantité : {{ item.quantity }}</p>
                                <p class="cart-item-price">{{ (item.product.price / 100)|number_format(2, ',', '') }}€</p>
                            </div>
                        </div>
                    {% endfor %}

                    {# 🎯 Total dynamique #}
                    <div class="cart-summary">
                        <p class="cart-summary-total">Total panier : <span>{{ total|number_format(2, ',', '') }}€</span></p>
                        <p class="cart-summary-shipping">Frais de livraison : Offert</p>
                    </div>
                {% else %}
                    <p style="text-align: center; color: var(--color-muted);">Votre panier est tristement vide.</p>
                {% endif %}

            </div>

            {# 🎯 On cache le bouton de validation si le panier est vide #}
            {% if items|length > 0 %}
                <button class="btn-validate-order">Valider la commande</button>
            {% endif %}

        </div>
    </div>
{% endblock %}
