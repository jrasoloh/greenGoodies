{% extends 'base.html.twig' %}

{% block title %}{{ product.name }} - Green Goodies{% endblock %}

{% block body %}
    <section class="product-detail-container">

        {# Panneau Gauche : L'image contrainte à 734x686 #}
        <div class="product-detail-image">
            {% if product.picture %}
                <img src="{{ asset('uploads/products/' ~ product.picture) }}" alt="{{ product.name }}">
            {% endif %}
        </div>

        {# Panneau Droit : Le conteneur qui fait aussi 686px de haut #}
        <div class="product-detail-info">
            <div class="product-detail-content">

                {# Le bloc du haut : Titre, prix, description (figé en haut) #}
                <div class="product-detail-top">
                    <h1>{{ product.name }}</h1>
                    <p class="product-detail-price">{{ (product.price / 100)|number_format(2, ',', ' ') }}€</p>

                    <h2 class="description-label">Description</h2>
                    <div class="product-description">
                        <p>{{ product.longDescription|nl2br }}</p>
                    </div>
                </div>

                {# 🎯 Formulaire avec sélection de la quantité #}
                <form action="{{ path('app_cart_add', {'id': product.id}) }}" method="POST" class="add-to-cart-form">

                    <div class="quantity-wrapper">
                        <label for="quantity">Quantité</label>
                        <input type="number" id="quantity" name="quantity" value="1" min="1" max="99" class="qty-input">
                    </div>

                    <button type="submit" class="btn-cta">Ajouter au panier</button>

                </form>

            </div>
        </div>

    </section>
{% endblock %}
