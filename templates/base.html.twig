<!DOCTYPE html>
<html lang="fr">
    <head>
        <meta charset="UTF-8">
        <title>{% block title %}Green Goodies{% endblock %}</title>
        <meta name="viewport" content="width=device-width, initial-scale=1.0">
        <link rel="icon" href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 128 128%22><text y=%221.2em%22 font-size=%2296%22>🌱</text></svg>">

        {# Google Fonts #}
        <link rel="preconnect" href="https://fonts.googleapis.com">
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
        <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600&display=swap" rel="stylesheet">

        {% block stylesheets %}
            {{ importmap('app') }}
        {% endblock %}

        {% block javascripts %}
            {{ importmap('app') }}
        {% endblock %}
    </head>
    <body>

    <header>
        <div class="container header-wrapper">
            <a href="{{ path('app_home') }}">
                <img src="{{ asset('images/logo.svg') }}" alt="Logo Green Goodies" style="height: 24px; width: auto;">
            </a>

            <nav class="nav-links">
                <a href="{{ path('app_home') }}#catalog-section">Nos produits</a>
                <a href="{{ path('app_cart') }}">Mon panier</a>

                {% if app.user %}
                    <a href="{{ path('app_account_index') }}">Mon compte</a>
                    <a href="{{ path('app_logout') }}">Déconnexion</a>
                {% else %}
                    <a href="{{ path('app_login') }}">Connexion</a>
                    <a href="{{ path('app_register') }}">Inscription</a>
                {% endif %}
            </nav>
        </div>
    </header>

    <main>
        {# 🎯 Affichage des messages de confirmation ou d'erreur #}
        {% for label, messages in app.flashes %}
            {% for message in messages %}
                <div class="flash-message flash-{{ label }}">
                    {{ message }}
                </div>
            {% endfor %}
        {% endfor %}

        {% block body %}{% endblock %}
    </main>

    <footer>
        <div class="container footer-wrapper">
            <p>&copy; Green Goodies - {{ "now"|date("Y") }}</p>
        </div>
    </footer>

    </body>
</html>
