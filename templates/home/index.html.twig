{% extends 'base.html.twig' %}

{% block title %}Accueil - Green Goodies{% endblock %}

{% block body %}
    <div style="max-width: 1200px; margin: 0 auto; padding: 20px;">

        <h1 style="text-align: center; margin-bottom: 40px;">Nos produits</h1>

        <div style="display: grid; grid-template-columns: repeat(3, 1fr); gap: 30px;">
            {# On boucle sur chaque produit récupéré depuis la base de données #}
            {% for product in products %}
                <div style="text-align: center;">

                    {# L'image pointe vers le dossier public/uploads/products/ #}
                    {% if product.picture %}
                        <img src="{{ asset('uploads/products/' ~ product.picture) }}" alt="{{ product.name }}" style="width: 100%; height: 300px; object-fit: cover;">
                    {% endif %}

                    <h3 style="margin: 15px 0 5px;">{{ product.name }}</h3>
                    <p style="color: #666; font-size: 0.9em; margin-bottom: 15px;">{{ product.shortDescription }}</p>

                    {# ASTUCE PRO : On divise le prix par 100 car il est stocké en centimes ! #}
                    <p style="font-weight: bold; font-size: 1.1em;">{{ (product.price / 100)|number_format(2, ',', ' ') }} €</p>

                    <a href="#" style="text-decoration: none; color: black; font-size: 0.9em;">Voir le produit</a>
                </div>
            {% else %}
                <p>Aucun produit disponible pour le moment.</p>
            {% endfor %}
        </div>

    </div>
{% endblock %}
